ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Demo SaaS-metrics dataset (read-only role)
DEMO_DATABASE_URL=postgresql+psycopg2://copilot_readonly:copilot_readonly@localhost:5432/sql_copilot_demo
DEMO_DATABASE_ADMIN_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sql_copilot_demo

# App database — stores orgs, connections, conversations (port 5433)
APP_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/sql_copilot_app

# Sandbox limits (EXPLAIN cost guard applies to both tiers; rows/timeout are tiered below)
SANDBOX_MAX_PLAN_COST=100000

AGENT_MAX_TURNS=8

# Clerk — get from https://dashboard.clerk.com > API Keys (enable Organizations)
CLERK_SECRET_KEY=sk_test_...

# Set true to skip JWT verification in local dev (no Clerk account needed)
DISABLE_AUTH=false

# Fernet key for encrypting tenant DB credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:3000

# Stripe — https://dashboard.stripe.com (test mode). Price ID from a recurring
# "Pro" product; webhook secret from `stripe listen --forward-to localhost:8000/billing/webhook`
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...

FREE_TIER_MONTHLY_QUERY_LIMIT=20
FREE_TIER_MAX_ROWS=1000
FREE_TIER_STATEMENT_TIMEOUT_MS=5000
PRO_TIER_MAX_ROWS=5000
PRO_TIER_STATEMENT_TIMEOUT_MS=15000

# Langfuse — free tier, Project Settings > API Keys.
# Leave the keys blank to disable tracing entirely (agent runs fine without it).
#
# LANGFUSE_HOST MUST match the data region your project was created in — the
# regions have fully isolated accounts, so keys from one return 401 against
# any other. Check the domain you're logged into:
#   EU  https://cloud.langfuse.com
#   US  https://us.cloud.langfuse.com
#   JP  https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
